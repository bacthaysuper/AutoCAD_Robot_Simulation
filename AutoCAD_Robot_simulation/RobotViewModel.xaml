<UserControl x:Class="AutoCAD_Robot_simulation.RobotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoCAD_Robot_simulation"
             Background="#1E1E1E" 
             FontFamily="Segoe UI"
             MinWidth="300" MinHeight="400">

    <UserControl.DataContext>
        <local:RobotViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MechanicalButton" TargetType="Button">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D35400"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DynamicAiButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15">
            <StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" 
                           Source="F:\Hust icon.png" 
                           Width="45" Height="45" 
                           Margin="0,0,10,0" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="INDUSTRIAL ROBOT SIMULATION" 
                                   Foreground="#00D2D3" 
                                   FontSize="18" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="HANOI UNIVERSITY OF SCIENCE AND TECHNOLOGY" 
                                   Foreground="#AAAAAA" 
                                   FontSize="9" 
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="2" Fill="#3F3F46" Margin="0,0,0,15"/>

                <Border Background="#252526" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="KINEMATICS SETUP" Foreground="#E67E22" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Lower Arm Length (L1):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding LowerArmLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Upper Arm Length (L2):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding UpperArmLength, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Background="#252526" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="GEMINI AI ENGINE" Foreground="#00D2D3" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Voice / Text Command:" Style="{StaticResource LabelStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AiCommandText, UpdateSourceTrigger=PropertyChanged}" Height="40" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Button Grid.Column="2" Content="Send" Style="{StaticResource MechanicalButton}" Background="#3498DB" Command="{Binding SendAiCommand}"/>
                        </Grid>

                        <Button Content="{Binding MicButtonText}" 
                                Command="{Binding ToggleMicCommand}" 
                                Background="{Binding MicButtonColor}" 
                                Style="{StaticResource DynamicAiButton}" 
                                Height="40"/>

                        <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Status}" Foreground="#00D2D3" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Content="START PICK AND PLACE SIMULATION" Style="{StaticResource MechanicalButton}" Height="45" FontSize="14" Command="{Binding PickPlaceCommand}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>