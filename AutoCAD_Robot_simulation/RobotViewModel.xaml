<UserControl x:Class="AutoCAD_Robot_simulation.RobotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoCAD_Robot_simulation"
             Background="#F5F6FA"
             MinWidth="300" MinHeight="500">

    <UserControl.DataContext>
        <local:RobotViewModel />
    </UserControl.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15,20,20,20">

                <TextBlock Text="INDUSTRIAL ROBOT CONTROL" FontWeight="Bold" FontSize="18" Foreground="#2C3E50" Margin="0,0,0,20" />

                <TextBlock Text="Lower Arm Length (L1):" Foreground="#34495E" FontSize="14" />
                <TextBox Text="{Binding LowerArmLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,15" Padding="6" FontSize="14" />

                <TextBlock Text="Upper Arm Length (L2):" Foreground="#34495E" FontSize="14" />
                <TextBox Text="{Binding UpperArmLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,20" Padding="6" FontSize="14" />

                <Button Content="START PICK AND PLACE" Command="{Binding PickPlaceCommand}" Background="#E67E22" Foreground="White" FontWeight="Bold" Height="45" FontSize="14" Margin="0,0,0,20" />

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>

                        <TextBlock Text="AI Command:" Foreground="#34495E" FontSize="14" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="75" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AiCommandText, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Send" Command="{Binding SendAiCommand}" Background="#9B59B6" Foreground="White" FontWeight="Bold" FontSize="14" />
                        </Grid>
                        <Button x:Name="MicButton" Content="{Binding MicButtonText}" Command="{Binding ToggleMicCommand}"
                                Background="{Binding MicButtonColor}" Foreground="White" FontWeight="Bold" Height="40" FontSize="14" Margin="0,15,0,10" />

                        <TextBlock Text="{Binding Status}" Foreground="#7F8C8D" FontStyle="Italic" FontSize="12" TextWrapping="Wrap" />

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>